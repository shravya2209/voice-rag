# ── API Keys ───────────────────────────────────────────────────
ELEVENLABS_API_KEY=
LLM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── LLM Configuration ─────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
# LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini

# ── Embedding ──────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Chunking ───────────────────────────────────────────────────
CHUNKING_STRATEGY=sentence
CHUNK_SIZE=256
CHUNK_OVERLAP=50

# ── Retrieval ──────────────────────────────────────────────────
RETRIEVAL_MODE=hybrid
TOP_K=5
RETRIEVAL_CANDIDATES=20
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6

# ── Reranker ───────────────────────────────────────────────────
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Guardrails ─────────────────────────────────────────────────
GUARDRAILS_ENABLED=true
MIN_RELEVANCE_SCORE=0.25

# ── Dataset ────────────────────────────────────────────────────
DATASET_MAX_ROWS=5000

# ── Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
